# ========================================================
# Caddyfile for Iran VPS (artgasht.ir) with Manual TLS
# Use this when international internet is down or ACME/Let's Encrypt fails.
# ========================================================

artgasht.ir, www.artgasht.ir {
    # Manual TLS Certificates (Cert + Key)
    tls /etc/caddy/certs/artgasht.ir.crt /etc/caddy/certs/artgasht.ir.key

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self)"
        -Server
    }

    @static {
        path /assets/* /fonts/* /icons/* /favicon.png
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    @uploads {
        path /uploads/*
    }
    header @uploads {
        Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    @html_sw {
        path / /index.html /sw.js /manifest.json
    }
    header @html_sw {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        health_uri /health
        health_interval 15s
        health_timeout 3s
    }

    log {
        output file /var/log/caddy/artgasht_ir_access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
