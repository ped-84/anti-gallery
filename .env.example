# ========================================================
# Anti-Gallery (آرت‌گشت) Environment Configuration Template
# Copy this file to .env on the server and replace placeholder values.
# NEVER commit your production .env with real credentials.
# ========================================================

# Application Port (Internal)
PORT=3000
NODE_ENV=production

# Admin Panel Authentication
# Choose a strong password for editing exhibitions in /#admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_SECRET=generate_a_random_32_char_secret_string

# Neshan Map Web Keys (Can be domain-specific for artgasht.ir vs artgasht.com)
# Default key used if domain-specific key is not set
NESHAN_WEB_KEY=web.cd0b84e26a35496f87485087bce939da

# Specific key for artgasht.ir (Iran VPS)
NESHAN_KEY_IR=web.cd0b84e26a35496f87485087bce939da

# Specific key for artgasht.com (Germany VPS)
NESHAN_KEY_COM=web.cd0b84e26a35496f87485087bce939da

# Persistent data path (Inside Docker container this is /app/data)
DATA_DIR=/app/data
