# ========================================================
# Anti-Gallery (آرت‌گشت) Environment Configuration Template
# Copy this file to .env on each server and replace values.
# IMPORTANT: Values must be ALPHANUMERIC ONLY (no quotes, no $, &, !)
# because bash scripts 'source' this file during systemd operations.
# ========================================================

# Server Role:
#   primary -> Germany VPS (artgasht.com): Source of truth, Admin Panel enabled
#   mirror  -> Iran VPS    (artgasht.ir)   : Read-only replica, Admin disabled unless STANDALONE flag exists
SERVER_ROLE=primary

# Public Domain (Used by Caddy reverse proxy)
DOMAIN=artgasht.com

# Admin Panel Security
# CRITICAL: Use ALPHANUMERIC characters only ([a-zA-Z0-9]) - minimum 24 chars!
ADMIN_PASSWORD=changeThisToALongRandomAlphanumericPassword2026
ADMIN_SECRET=generateA32CharAlphanumericSecretStringHere2026
ADMIN_ENABLED=true

# Upstream Exhibition Scraper (galleryinfo.ir)
# Can run on PRIMARY (Germany) as source of truth, or on MIRROR if network allows
SCRAPER_ENABLED=true

# Port & Node Environment
PORT=3000
NODE_ENV=production
DATA_DIR=/app/data

# Neshan Map Web Keys (Configurable per domain)
NESHAN_WEB_KEY=web.cd0b84e26a35496f87485087bce939da
NESHAN_KEY_IR=web.cd0b84e26a35496f87485087bce939da
NESHAN_KEY_COM=web.cd0b84e26a35496f87485087bce939da

# --- For MIRROR (Iran VPS) only: Primary Sync Connection Settings ---
# Used by scripts/sync-pull.sh and scripts/mirror-mode.sh
PRIMARY_HOST=86.54.42.206
PRIMARY_USER=deploy
PRIMARY_PORT=22
PRIMARY_KEY=/home/deploy/.ssh/id_rsa
PRIMARY_DATA_DIR=/opt/artgasht/data
