# ========================================================
# Caddyfile Configuration for Anti-Gallery (آرت‌گشت)
# Dynamically configured per server via DOMAIN environment variable:
#   - Primary (Germany): DOMAIN=artgasht.com
#   - Mirror  (Iran):    DOMAIN=artgasht.ir
# ========================================================

{$DOMAIN:artgasht.com} {
    # Manual TLS certificate support for Iran server (when Let's Encrypt is unreachable)
    # If TLS_CERT and TLS_KEY are defined, uncomment or configure them below:
    # tls {$TLS_CERT} {$TLS_KEY}

    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self)"
        -Server
    }

    # Static assets caching (Long TTL for immutable hashed assets)
    @static {
        path /assets/* /fonts/* /icons/* /favicon.png
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Uploaded exhibition posters caching
    @uploads {
        path /uploads/*
    }
    header @uploads {
        Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    # Service Worker & HTML (Never cache HTML or SW stale)
    @html_sw {
        path / /index.html /sw.js /manifest.json
    }
    header @html_sw {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # Reverse proxy to backend Express container
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check upstream monitoring
        health_uri /health
        health_interval 15s
        health_timeout 3s
    }

    # Access logging
    log {
        output file /var/log/caddy/artgasht_access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
