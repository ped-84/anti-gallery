# ========================================================
# Caddyfile for Primary Server (Frankfurt VPS - artgasht.com)
# Automatic HTTPS for artgasht.com & www.artgasht.com
# Reverse proxy to Docker container at 127.0.0.1:3000
# ========================================================

artgasht.com, www.artgasht.com {
    # Automatic TLS management (Let's Encrypt & ZeroSSL)
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self)"
        -Server
    }

    # Static assets caching (immutable cache for hashed assets)
    @static {
        path /assets/* /fonts/* /icons/* /favicon.png
    }
    header @static {
        Cache-Control "public, max-age=31536000, immutable"
    }

    # Uploaded exhibition posters caching
    @uploads {
        path /uploads/*
    }
    header @uploads {
        Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    }

    # Service Worker & HTML (Never cache HTML or Service Worker)
    @html_sw {
        path / /index.html /sw.js /manifest.json
    }
    header @html_sw {
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }

    # Reverse proxy to backend Express container
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Upstream Health Check
        health_uri /health
        health_interval 15s
        health_timeout 3s
    }

    # Access logging
    log {
        output file /var/log/caddy/artgasht_com_access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
